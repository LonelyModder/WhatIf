var metCooniebeforeVervecken, metVervecken;
starting
begin
	InGameOn;
	PrepareHero1cont;
	PrepareBuildings1cont;
	Wait(0$2);
	Intro1cont;
	InGameOff;
end;

every 0$1 trigger GetLives(Coonie)<1000 do
//var who;
begin
	//who := FilterAllUnits([[f_side,3],[f_type,unit_human]]);
    DialogueOn;
		SetAttitude(2,1,att_friend,true);
        //ComStop(who);
		Say(Omar,'M1contCoonie-1');
		Say(Coonie,'M1contCoonie-2');
		Say(Omar,'M1contCoonie-3');
		Say(Coonie,'M1contCoonie-4');
		Say(Omar,'M1contCoonie-5');
		Say(Coonie,'M1contCoonie-6');
		Case Query('QCoonie') of
			1:begin
				Say(Omar,'M1contCoonie-7');
				Say(Coonie,'M1contCoonie-8');
				Say(Omar,'M1contCoonie-9');
				Say(Coonie,'M1contCoonie-10');
				Say(Omar,'M1contCoonie-11');
				SetSide(Coonie,2);
				if metVervecken = false then
					begin
					metCooniebeforeVervecken := true
					end
			end;
			2:begin
				Say(Omar,'M1contCoonie-alt1');
				Say(Coonie,'M1contCoonie-alt2');
				SetAttitude(2,1,att_enemy,true);
			end;
		end;
    DialogueOff;
end;

every 0$1 trigger GetDistUnitXY(Omar,109,73) < 8 do
begin
    InGameOn;
		SayRadio(Abdul,'M1contAbdulVervecken-1');
		Say(Omar,'M1contAbdulVervecken-2');
    InGameOff;
end;

every 0$1 trigger GetDistUnitXY(Omar,18,30) < 8 do
begin
    InGameOn;
		Say(Omar,'M1contVervecken-1');
		SetAttitude(2,5,att_friend,true);
		uc_side := 5;
		PlaceUnitXY(Vervecken,17,29,false);
		PlaceUnitXY(Gali,16,29,false);
		PlaceUnitXY(Kaia,16,30,false);
		PlaceUnitXY(Nahla,18,29,false);
		Say(Vervecken,'M1contVervecken-2');
		Say(Vervecken,'M1contVervecken-3');
		Say(Omar,'M1contVervecken-4');
		SetSide(Vervecken,2);
		SetSide(Kaia,2);
		SetSide(Gali,2);
		SetSide(Nahla,2);
		Say(Vervecken,'M1contVervecken-5');
		Say(Vervecken,'M1contVervecken-6');
		Say(Vervecken,'M1contVervecken-7');
		Say(Vervecken,'M1contVervecken-8');
		Say(Omar,'M1contVervecken-9');
		Say(Kaia,'M1contVervecken-10');
		Say(Omar,'M1contVervecken-11');
		Say(Vervecken,'M1contVervecken-12');
		Say(Gali,'M1contVervecken-13');
		SetTech(tech_explos, 2, state_researched);
    InGameOff;
	metVervecken := true;
end;

every 0$1 trigger GetDistUnits(Vervecken,Coonie) < 7 and metCooniebeforeVervecken = true do
begin
    InGameOn;
	Say(Vervecken,'M1contVerveckenCoonie-1');
	Say(Coonie,'M1contVerveckenCoonie-2');
	Say(Omar,'M1contVerveckenCoonie-3');
	Say(Vervecken,'M1contVerveckenCoonie-4');
	InGameOff;
end;

every 0$1 trigger GetLives(Tokarczuk)<1000 do
begin
    DialogueOn;
	Say(Tokarczuk,'M1contTokarczuk-1');
	Say(Omar,'M1contTokarczuk-2');
	DialogueOff;
end;
