var metCooniebeforeKurt, metKurt;
starting
begin
	InGameOn;
	PrepareHero1cont;
	PrepareBuildings1cont;
	Wait(0$2);
	Intro1cont;
	InGameOff;
end;

every 0$1 trigger GetLives(Coonie)<1000 do
var who;
begin
	who := FilterAllUnits([[f_side,3],[f_type,unit_human]]);
    DialogueOn;
		SetAttitude(2,1,att_friend,true);
        ComStop(who);
		Say(Omar,'M1contCoonie-1');
		Say(Coonie,'M1contCoonie-2');
		Say(Omar,'M1contCoonie-3');
		Say(Coonie,'M1contCoonie-4');
		Say(Omar,'M1contCoonie-5');
		Say(Coonie,'M1contCoonie-6');
		Case Query('QCoonie') of
			1:begin
				Say(Omar,'M1contCoonie-7');
				Say(Coonie,'M1contCoonie-8');
				Say(Omar,'M1contCoonie-9');
				Say(Coonie,'M1contCoonie-10');
				Say(Omar,'M1contCoonie-11');
				SetSide(Coonie,2);
				if metKurt = false then
					begin
					metCooniebeforeKurt := true
					end
			end;
			2:begin
				Say(Omar,'M1contCoonie-alt1');
				Say(Coonie,'M1contCoonie-alt2');
				SetAttitude(2,1,att_enemy,true);
			end;
		end;
    DialogueOff;
end;

every 0$1 trigger GetDistUnitXY(Omar,109,73) < 8 do
begin
    InGameOn;
		SayRadio(Abdul,'M1contAbdulKurt-1');
		Say(Omar,'M1contAbdulKurt-2');
    InGameOff;
end;

every 0$1 trigger GetDistUnitXY(Omar,18,30) < 8 do
begin
    InGameOn;
		Say(Omar,'M1contKurt-1');
		SetAttitude(2,5,att_friend,true);
		uc_side := 5;
		PlaceUnitXY(Kurt,17,29,false);
		PlaceUnitXY(Kaia,16,30,false);
		Say(Kurt,'M1contKurt-2');
		Say(Kurt,'M1contKurt-3');
		Say(Omar,'M1contKurt-4');
		SetSide(Kurt,2);
		SetSide(Kaia,2);
		Say(Kurt,'M1contKurt-5');
		Say(Kurt,'M1contKurt-6');
		Say(Kurt,'M1contKurt-7');
		Say(Kurt,'M1contKurt-8');
		Say(Omar,'M1contKurt-9');
		Say(Kaia,'M1contKurt-10');
		Say(Omar,'M1contKurt-11');
		Say(Kurt,'M1contKurt-12');
		Say(Omar,'M1contKurt-13');
		SetTech(tech_explos, 2, state_researched);
    InGameOff;
	metKurt := true;
end;

every 0$1 trigger GetDistUnits(Kurt,Coonie) < 7 and metCooniebeforeKurt = true do
begin
    InGameOn;
	Say(Kurt,'M1contKurtCoonie-1');
	Say(Coonie,'M1contKurtCoonie-2');
	Say(Omar,'M1contKurtCoonie-3');
	Say(Kurt,'M1contKurtCoonie-4');
	InGameOff;
end;
