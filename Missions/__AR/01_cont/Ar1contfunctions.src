Export Omar, Abdul, Coonie, Vervecken, Gali, Tokarczuk, Nahla, Kaia, Yakotich;

Export Function PrepareHero1cont;
begin
    InGameOn;
    CenterNowOnXY(103,97);
	uc_side := 1;
	Coonie := NewCharacter('Coonie');
    uc_side := 2;
    Omar := NewCharacter('Omar');
	uc_side := 3;
	Yakotich := NewCharacter('Yakotich');
	Tokarczuk := NewCharacter('Tokarczuk');
    uc_side := 5;
    Abdul := NewCharacter('Abdul');
	Vervecken := NewCharacter('Vervecken');
	Gali := NewCharacter('Gali');
	Kaia := NewCharacter('Kaia');
	Nahla := NewCharacter('Nahla');
    DWait(0$2);
    PlaceUnitXY(Omar,103,97,true);
	PlaceUnitXY(Coonie,46,83,false);
	PlaceUnitXY(Yakotich,96,15,false);
	PlaceUnitXY(Tokarczuk,62,46,false);
    CenterOnUnits(Omar);
    InGameOff;
end;

Export Function Intro1cont;
begin
    InGameOn;
	Say(Omar,'M1contArIntro-1');
	commovexy(Omar,105,95);
	Say(Omar,'M1contArIntro-2');
	commovexy(Omar,97,94);
	Say(Omar,'M1contArIntro-3');
	commovexy(Omar,94,89);
	Say(Omar,'M1contArIntro-4');
	commovexy(Omar,102,96);
	SayRadio(Omar,'M1contArIntro-5');
	SayRadio(Abdul,'M1contArIntro-6');
	Say(Omar,'M1contArIntro-7');
	InGameOff;
	ChangeMissionObjectives('Ar_1cont_1');
	SaveForQuickRestart;
end;

Export Function PrepareBuildings1cont;
var bunkers,depot,lab,i,j,sol;
begin
    bunkers := FilterAllUnits([ [f_side,3],[f_btype,b_breastwork]]);
	depots := FilterAllUnits([ [f_side,3],[f_btype,b_depot]]);
	labs := FilterAllUnits([ [f_side,3],[f_btype,b_lab]]);

    for i=1 to bunkers do
		begin
			uc_side := 3;
			uc_nation := 3;

			PrepareSoldier(1,2);
			sol := CreateHuman;
			PlaceUnitInBunker(sol,bunkers[i]);
		end;
	for i=1 to depots do
		begin
			uc_side := 3;
			uc_nation := 3;

			PrepareEngineer(1,2);
			sol := CreateHuman;
			PlaceUnitInBunker(sol,depots[i]);
		end;
	for i=1 to labs do
		begin
			uc_side := 3;
			uc_nation := 3;

			PrepareScientist(1,2);
			sol := CreateHuman;
			PlaceUnitInBunker(sol,labs[i]);
		end;
end;

Export Function PlaceUnitInBunker(un, b);
var dir;
begin
dir := GetDir(b);

if dir<3 then
	dir := dir + 3
else
	dir := dir - 3;
	
SetDir(un, dir);
PlaceHumanInUnit(un, b);
end;