var budovy, atackers, followhk, followgsh;
starting
begin
   budovy=[depot1,depot2,depot3,lab1,arm1,arm2,eon];
   InGameOn;
   PrepareHero;
   PrepareBuildings;
   atackers := [];
   atackers := FilterAllUnits([f_side,5]);

   CenterOnUnits(Omar);
   Wait(0$2);
   Say(Omar,'M1ArIntro-1');
   SayRadio(Abdul,'M1ArIntro-2');
   Say(Omar,'M1ArIntro-3');
   SayRadio(Omar,'M1ArIntro-4');
   SayRadio(Heike,'M1ArIntro-5');
   SayRadio(Farmer,'M1ArIntro-6');
   SayRadio(Gensher,'M1ArIntro-7');
   SayRadio(Omar,'M1ArIntro-8');
   SayRadio(Bergkamp,'M1ArIntro-9');
   SayRadio(Omar,'M1ArIntro-10');
   InGameOff;
   DoNotAttack(2,eon);
   ComWalk(atackers);
   AddComAgressiveMove(atackers,47,38);
   ComAgressiveMove(Bergkamp,75,35);
   ChangeMissionObjectives('Ar_1_1');
   SaveForQuickRestart;
end;

every 0$1 trigger GetLives(Ar1Sniper1)<1000 or GetLives(Ar1Soldier1)<1000 or GetLives(Ar1Soldier2)<1000 or GetLives(Ar1Soldier3)<1000 or GetLives(Truman)<1000 do
begin
    InGameOn;
        Say(Omar,'M1ArTruman-1');
		Say(Truman,'M1ArTruman-2');
		Say(Omar,'M1ArTruman-3');
		SayRadio(Omar,'M1ArTruman-4');
		SayRadio(Farmer,'M1ArTruman-5');
		//Spy's charges
		MineExplosion(41,43,1);
		MineExplosion(45,45,1);
		MineExplosion(49,45,1);
		MineExplosion(52,44,1);
		MineExplosion(42,31,1);
		MineExplosion(42,28,1);
		MineExplosion(47,34,1);
		MineExplosion(46,30,1);
		MineExplosion(54,40,1);
		MineExplosion(56,37,1);
    InGameOff;
end;

every 0$1 trigger GetLives(Joan)<1000 do
begin
    InGameOn;
		comenterunit(Joan,eon);
		Say(Joan,'M1ArJoan-1');
    InGameOff;
end;

every 0$1 trigger FilterAllUnits([[f_side,4],[f_type,unit_human],[f_ok]]) = 0 do
begin
	ComStop(atackers);
	AddComMoveXY([Bergkamp],75,35);
	InGameOn;
	commovexy(Gensher,47,38);
	commovexy(Heike,47,38);
	commovexy(Farmer,47,38);
	Say(Omar,'M1ArAmDead-1');
	Say(Farmer,'M1ArAmDead-2');
	Say(Omar,'M1ArAmDead-3');
	Say(Farmer,'M1ArAmDead-4');
	Say(Omar,'M1ArAmDead-5');
	Say(Gensher,'M1ArAmDead-6');
	Say(Omar,'M1ArAmDead-7');
	SayRadio(Omar,'M1ArAmDead-8');
	SayRadio(Bergkamp,'M1ArAmDead-9');
	SayRadio(Omar,'M1ArAmDead-10');
	Say(Omar,'M1ArAmDead-11');
	Say(Gensher,'M1ArAmDead-12');
	Say(Omar,'M1ArAmDead-13');
	Say(Farmer,'M1ArAmDead-14');
	followgsh:=true;
	followhk:=true;
	InGameOff;
end;

every 0$0.5 trigger followhk=true do //heike followuje omara
var tmp,tmp2,tmp3,x,y,px,py,dir;
begin
  tmp=getdistunits(Omar,Heike);
  x=getx(Omar);
  y=gety(Omar);
  tmp2=[];
  tmp3=[];
  if tmp>=7 then begin
    for dir=0 to 5 do begin
      px=shiftx(x,dir,tmp-2);
      py=shifty(y,dir,tmp-2);
      if ValidHex(px,py) then
        begin
         tmp2=tmp2^[[px,py]];
         tmp3=tmp3^[getdistunitxy(Heike,px,py)];
        end
    end;
    tmp=bestfromlistbylist(tmp2,tmp3);
    commovexy(Heike,tmp[1],tmp[2]);
  end;
  enable;
end;

every 0$0.5 trigger followgsh=true do //gensher followuje omara
var tmp,tmp2,tmp3,x,y,px,py,dir;
begin
  tmp=getdistunits(Omar,Gensher);
  x=getx(Omar);
  y=gety(Omar);
  tmp2=[];
  tmp3=[];
  if tmp>=7 then begin
    for dir=0 to 5 do begin
      px=shiftx(x,dir,tmp-2);
      py=shifty(y,dir,tmp-2);
      if ValidHex(px,py) then
        begin
         tmp2=tmp2^[[px,py]];
         tmp3=tmp3^[getdistunitxy(Gensher,px,py)];
        end
    end;
    tmp=bestfromlistbylist(tmp2,tmp3);
    commovexy(Gensher,tmp[1],tmp[2]);
  end;
  enable;
end;

every 0$1 trigger GetDistUnits(Omar,Bergkamp) < 10 do
begin
	followgsh:=false;
	followhk:=false;
	commovexy(Gensher,69,33);
	commovexy(Heike,69,33);
    InGameOn;
	Say(Omar,'M1ArFuckup-1');
	Say(Bergkamp,'M1ArFuckup-2');
	Say(Omar,'M1ArFuckup-3');
	Say(Bergkamp,'M1ArFuckup-4');
	Say(Omar,'M1ArFuckup-5');
	Say(Bergkamp,'M1ArFuckup-6');
	Say(Omar,'M1ArFuckup-7');
	comenterunit(Bergkamp,eon);
	Say(Gensher,'M1ArFuckup-8');
	Say(Omar,'M1ArFuckup-9');
	comenterunit(Omar,eon);
	Say(Gensher,'M1ArFuckup-10');
	Say(Heike,'M1ArFuckup-11');
	comenterunit(Heike,eon);
	Say(Gensher,'M1ArFuckup-12');
	InGameOff;
end;

on enterbuilding(b,Omar) do
begin
    if b=eon and FilterAllUnits([[f_side,2],[f_type,unit_human],[f_ok]]) = 0 then
		begin
			Wait(0$4);
			savecharacters(Omar,'Omar');
			changemap('%_cont','%_cont');
		end
end;