Export Omar, Abdul, Heike, Farmer, Truman, Joan;

Export Function PrepareHero;
begin
	uc_side := 2;
	Omar := NewCharacter('Omar');
	uc_side := 5;
	Abdul := NewCharacter('Abdul');
	Heike := NewCharacter('Heike');
	Farmer := NewCharacter('Farmer');
	uc_side := 4;
	Truman := NewCharacter('Truman');
	Joan := NewCharacter('Joan');
	
	PlaceUnitXY(Truman,51,41,false);
	PlaceUnitXY(Joan,77,35,false);
	PlaceUnitXY(Omar,30,49,false);
	PlaceUnitXY(Heike,46,6,false);
	PlaceUnitXY(Farmer,96,61,false);
	CenterOnUnits(Omar);
end;

Export Function PrepareBuildings;
var armories,depots,labs,i,j,sol;
begin
    armories := FilterAllUnits([ [f_side,4],[f_btype,b_armoury]]);
	depots := FilterAllUnits([ [f_side,4],[f_btype,b_depot]]);
	labs := FilterAllUnits([ [f_side,4],[f_btype,b_lab]]);

    for i=1 to armories do
		begin
			uc_side := 4;
			uc_nation := 1;

			PrepareSoldier(1,2);
			sol := CreateHuman;
			PlaceHumanInUnit(sol,armories[i]);
		end;
	
	for i=1 to depots do
		begin
			uc_side := 4;
			uc_nation := 1;
			for j=1 to 2 do
			begin
				PrepareEngineer(1,2);
				sol := CreateHuman;
				PlaceHumanInUnit(sol,depots[i]);
			end;
		end;
	
	for i=1 to labs do
		begin
			uc_side := 4;
			uc_nation := 1;
			for j=1 to 4 do
			begin
				PrepareScientist(1,2);
				sol := CreateHuman;
				PlaceHumanInUnit(sol,labs[i]);
			end;
		end;
end;

Export Function AttackOrder;
var i, enemy, atackers;
begin
	
	enemy := FilterAllUnits([f_side,4]);
	atackers := FilterAllUnits([f_side,5]);
	
	for i=1 to atackers do
		ComAttackUnit(atackers[i], NearestUnitToUnit(enemy, atackers[i]));
end;