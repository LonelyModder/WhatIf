var metPeter;
starting
begin
   InGameOn;
   PrepareHero02;
   PrepareBunkers;
   IntroY;
   CenterOnUnits(VanHouten);
   //Wait(0$5);
   InGameOff;
   SaveForQuickRestart;
end;

every 0$1 trigger GetDistUnits(Yamoko,VanHouten)<7 and AM01_YamokoScout = true do
begin
	InGameOn;
		Say(VanHouten,'M2Intro-1');
		Say(Yamoko,'M2Intro-2');
		Say(VanHouten,'M2Intro-3');
		Intro02;
	InGameOff;
end;

every 0$1 trigger GetDistUnits(Gladstone,VanHouten)<10 do
begin
	InGameOn;
		Say(VanHouten,'M2Gladsone-1');
		Say(Gladstone,'M2Gladsone-2');
		Say(VanHouten,'M2Gladsone-3');
		SetSide(Gladstone,1);
		SayRadio(VanHouten,'M2Gladsone-11');
		SayRadio(Powell,'M2Gladsone-12');
		SayRadio(VanHouten,'M2Gladsone-13');
		metPeter = true;
	InGameOff;
end;

every 0$1 trigger GetDistUnits(Gladstone,Harris)<10 and metPeter = true do
begin
	InGameOn;
		Say(Gladstone,'M2Gladsone-4');
		Say(Harris,'M2Gladsone-5');
		Say(Gladstone,'M2Gladsone-6');
		Say(Harris,'M2Gladsone-7');
		Say(VanHouten,'M2Gladsone-8');
		Say(Harris,'M2Gladsone-9');
		Say(VanHouten,'M2Gladsone-10');
	InGameOff;
end;

every 0$1 trigger GetDistUnits(Cornell,VanHouten)<70 do
begin
	InGameOn;
		SayRadio(Cornell,'M2Cornell-1');
		SayRadio(VanHouten,'M2Cornell-2');
		SayRadio(Cornell,'M2Cornell-3');
		SayRadio(VanHouten,'M2Cornell-4');
		ChangeMissionObjectives('side1');
	InGameOff;
end;

every 0$1 trigger GetDistUnits(Cornell,VanHouten)<10 do
begin
	InGameOn;
		Say(VanHouten,'M2Cornell-5');
		Say(Cornell,'M2Cornell-6');
		Say(VanHouten,'M2Cornell-7');
		Say(Cornell,'M2Cornell-8');
		Say(VanHouten,'M2Cornell-9');
		Say(Cornell,'M2Cornell-10');
		Say(VanHouten,'M2Cornell-11');
		Say(Cornell,'M2Cornell-12');
		Say(VanHouten,'M2Cornell-13');
		Say(Cornell,'M2Cornell-14');
		Say(VanHouten,'M2Cornell-15');
		SetSide(Cornell,1);
		SetSide(Frank,1);
		SetSide(Walker,1);
		SetSide(Jillian,1);
		ChangeMissionObjectives('Out_side1');
	InGameOff;
end;